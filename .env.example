# Copiar para .env; gerar segredos locais, nunca versionar .env.
POSTGRES_DB=deloya
POSTGRES_USER=deloya
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://deloya:ALTERAR@127.0.0.1:5433/deloya
DATABASE_DIRECT_URL=postgresql+psycopg://deloya:ALTERAR@127.0.0.1:5433/deloya
JWT_SECRET=
ENVIRONMENT=development
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
DEVELOPMENT_FRONTEND_ORIGINS=[]
# manual: transferência directa e confirmação pelo vendedor; demo: apenas testes.
PAYMENT_MODE=manual
DEMO_PASSWORD=
BACKEND_URL=http://127.0.0.1:8000
# Catálogo público e anexos privados usam stores e credenciais separados.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE_URL=
BLOB_PRIVATE_READ_WRITE_TOKEN=
