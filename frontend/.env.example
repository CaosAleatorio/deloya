BACKEND_URL=http://127.0.0.1:8000
# Na Vercel (Preview e Production), definir a origem HTTPS do projecto FastAPI
# antes do build. Ex.: https://deloya-api.vercel.app (sem /api/v1).
# Esta variável fica no servidor. Credenciais da base de dados e do Blob pertencem à API.
# Hosts adicionais de desenvolvimento, sem protocolo nem porta.
# Copiar para .env.local e preencher apenas quando aceder por outro IP/hostname.
DEV_ALLOWED_HOSTS=
